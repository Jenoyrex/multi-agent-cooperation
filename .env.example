# Copy this file to .env and fill in the API keys. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generation settings: the frozen runtime configuration (docs/spec.md §8.15).
# Pilot/full runs refuse any other value (check_approved_runtime in
# src/experiments/config.py). The code has no defaults for the first five
# settings of each provider; GenerationConfig.from_env raises if any is missing.

# --- Claude: scientific (preregistered) ---
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TEMPERATURE=1.0
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_EFFORT=medium
# Thinking is always sent as disabled by ClaudeAgent; no seed is sent.
# --- Claude: operational ---
CLAUDE_TIMEOUT_S=120
CLAUDE_MAX_RETRIES=3
CLAUDE_RETRY_BACKOFF_S=2.0

# --- OpenAI: scientific (preregistered) ---
# Non-reasoning GPT-4.1 snapshot. No reasoning effort and no seed are sent;
# do not set OPENAI_EFFORT (OpenAIAgent rejects it).
OPENAI_MODEL=gpt-4.1-2025-04-14
OPENAI_TEMPERATURE=1.0
OPENAI_MAX_OUTPUT_TOKENS=1024
# --- OpenAI: operational ---
OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_S=2.0

# MAX_ROUNDS = 10 (scientific) and max_transport_reruns = 2 (operational) are
# ExperimentConfig fields set by the run driver, not environment variables.
