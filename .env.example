# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generation settings. NONE have defaults: every value must be set explicitly
# (GenerationConfig.from_env raises if any is missing). Model ids are not
# chosen by the code; supply them here (or via GenerationConfig in code).
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TEMPERATURE=
CLAUDE_MAX_OUTPUT_TOKENS=
CLAUDE_TIMEOUT_S=
CLAUDE_MAX_RETRIES=
# CLAUDE_RETRY_BACKOFF_S=1.0   # optional

OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_S=
OPENAI_MAX_RETRIES=
# OPENAI_RETRY_BACKOFF_S=1.0   # optional
